{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "@NIXOS_LOGO@",
    "width": 32,
    "height": 16,
    "padding": { "top": 2, "right": 6, "left": 2 }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "│ ├ CPU",
      "showPeCoreCount": true,
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "│ ├ GPU",
      "detectionMethod": "pci",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": "│ ├ Display",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "│ ├ Disk",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "│ ├ Memory",
      "keyColor": "blue"
    },
    {
      "type": "swap",
      "key": "└ └ Swap",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": " OS",
      "keyColor": "cyan",
      "text": "nixos-version"
    },
    {
      "type": "command",
      "key": "│ ├ Generation",
      "keyColor": "cyan",
      "text": "readlink /run/current-system | sed 's/.*system-\\([0-9]*\\)-link/Generation \\1/'"
    },
    {
      "type": "kernel",
      "key": "│ ├ Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "│ ├ WM",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "│ ├ Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "│ ├ Packages",
      "keyColor": "cyan"
    },
    {
      "type": "terminalfont",
      "key": "└ └ Font",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": " OS Age",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": " Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %Y /run/current-system)) / 86400 )) days ago"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
